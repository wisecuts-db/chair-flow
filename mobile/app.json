{
  "expo": {
    "name": "ShopBoss",
    "slug": "chair-flow",
    "scheme": "chairflow",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F3EE",
    "ios": {
      "bundleIdentifier": "Com.chairflow123.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.chairflow123.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#17181B"
      }
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#17181B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1238d3cf-1961-44a1-9255-627ec2978bcb"
      }
    },
    "owner": "wisecuts"
  }
}
